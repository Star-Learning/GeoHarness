{
  "name": "geoharness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run build && node --test tests/*.test.mjs",
    "test:phase0": "node --test tests/phase0-integration.test.mjs",
    "test:phase1": "pnpm run build && node --test tests/phase1-ui-shell.test.mjs",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:phase1": "pnpm run typecheck && pnpm run test:phase1"
  }
}
