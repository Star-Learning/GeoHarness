{
  "name": "geoharness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build:scenarios": "node scripts/build_scenarios/build-fixtures.mjs",
    "check:scenarios": "node scripts/build_scenarios/build-fixtures.mjs --check",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm run build && pnpm run check:scenarios && node --test tests/*.test.mjs tests/scenarios/*.test.mjs && pnpm run test:python",
    "test:python": "python -m pytest backend/geo-service/tests -q",
    "test:phase0": "node --test tests/phase0-integration.test.mjs",
    "test:phase1": "pnpm run build && node --test tests/phase1-ui-shell.test.mjs",
    "test:phase2": "pnpm run check:scenarios && node --test tests/scenarios/*.test.mjs",
    "test:phase3": "pnpm run build && node --test tests/phase3-layer-map.test.mjs",
    "test:phase4": "python -m pytest backend/geo-service/tests -q",
    "test:phase5": "node --test tests/phase5-harness-tools.test.mjs",
    "verify:phase0": "node scripts/verify-phase0.mjs",
    "verify:phase1": "pnpm run typecheck && pnpm run test:phase1",
    "verify:phase2": "pnpm run test:phase2",
    "verify:phase3": "pnpm run typecheck && pnpm run test:phase3",
    "verify:phase4": "pnpm run test:phase4",
    "verify:phase5": "pnpm peers check && pnpm run test:phase5"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  }
}
