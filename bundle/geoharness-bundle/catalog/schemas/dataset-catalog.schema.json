{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://geoharness.dev/schemas/dataset-catalog-1.0.json",
  "title": "GeoHarness Dataset Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "region", "crs", "layers", "license"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 180 },
    "description": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "region": { "type": "string", "minLength": 1, "maxLength": 300 },
    "crs": { "type": "string", "minLength": 1, "maxLength": 80 },
    "snapshot_date": { "type": "string", "format": "date" },
    "publishers": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "path", "description"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$" },
          "path": { "type": "string", "minLength": 1, "maxLength": 500 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "license": { "type": "string", "minLength": 1, "maxLength": 300 },
    "source_audit": { "type": "string", "minLength": 1, "maxLength": 500 }
  }
}
